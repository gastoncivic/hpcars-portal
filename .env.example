# HP CARS Portal — Variables de entorno
# Copiá este archivo a .env y completá los valores

# Servidor
PORT=3000
NODE_ENV=production

# JWT (cambiar por una cadena aleatoria larga y segura)
JWT_SECRET=CAMBIAR_POR_CLAVE_SECRETA_LARGA_Y_ALEATORIA

# Base de datos SQLite
DB_PATH=./hpcars.db

# CORS (URL pública de tu app, separadas por coma si hay más de una)
CORS_ORIGIN=https://TU_DOMINIO.com

# Directorios de archivos
UPLOADS_DIR=./uploads
RESULTS_DIR=./results

# Admins (emails separados por coma)
ADMIN_EMAILS=angelgastoncalvo@gmail.com,EMAIL_GILDA@gmail.com

# ─── OAUTH (activar cuando tengas las credenciales) ───
# Google OAuth — https://console.cloud.google.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook OAuth — https://developers.facebook.com
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ─── EMAIL (activar para verificación y notificaciones) ───
# Nodemailer / SendGrid / Mailgun
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu@gmail.com
SMTP_PASS=

# ─── PADDLE (activar cuando esté listo) ───
PADDLE_API_KEY=
PADDLE_VENDOR_ID=
PADDLE_WEBHOOK_SECRET=
